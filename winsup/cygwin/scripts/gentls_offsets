#!/usr/bin/env bash
set -e
set -o pipefail

if [[ $# != 2 ]]
then
  echo "Usage: $0 input_file output_file" >&2
  exit 1
fi
: "${CXXCOMPILE:?CXXCOMPILE must name the C++ compiler}"

input_file=$1
output_file=$2
tmp_dir=$(mktemp -d -- "${output_file}.XXXXXX")

trap 'rm -f -- "$tmp_dir/members.cc" "$tmp_dir/offsets.s" "$tmp_dir/offsets";
      rmdir -- "$tmp_dir"' EXIT
trap 'exit 1' HUP INT TERM

# Preprocess cygtls.h and filter out only the member lines from
# class _cygtls to generate an input file for the cross compiler
# to generate the member offsets for tlsoffsets-$(target_cpu).h.
${CXXCOMPILE} -x c++ -E -P -include "${input_file}" /dev/null | \
gawk '
  BEGIN {
    # marker is used to split out the member lines from class _cygtls
    marker=0;
    # Prepare the input file for the subsequent compiler run.
    # Prepend value of __CYGTLS_PADSIZE__ so we can compute the offsets
    # up and down at the same time
    print "#include \"winsup.h\"";
    print "#include \"cygtls.h\"";
    print "extern \"C\" const uint32_t __CYGTLS__start_offset = __CYGTLS_PADSIZE__;";
  }
  /^class _cygtls$/ {
    # Ok, bump marker, next we are expecting a "public:" line
    marker=1;
  }
  /^public:/ {
    # We are only interested in the lines between the first (marker == 2)
    # and the second (marker == 3) "public:" line in class _cygtls.  These
    # are where the members are defined.
    # Keep reading afterwards so pipefail can catch late preprocessor errors.
    if (marker > 0) ++marker;
  }
  {
    if (marker == 2 && $1 != "public:" && NF > 0) {
      # Filter out function names
      $0 = gensub (/\(\*(\w+)\)\s*\([^\)]*\)/, "\\1", "g");
      # Filter out leading asterisk
      $NF = gensub (/^\**(\w+)/, "\\1", "g", $NF);
      # Filter out trailing array expression
      $NF = gensub (/(\w+)\s*\[[^\]]*\]/, "\\1", "g", $NF);
      $NF = gensub (/(\w+);/, "\\1", "g", $NF);
      print "extern \"C\" const uint32_t __CYGTLS__" $NF " = offsetof (class _cygtls, " $NF ");";
    }
  }
  END {
    if (marker < 3) {
      print "Error: could not find the _cygtls member block" > "/dev/stderr";
      exit 1;
    }
  }
' > "$tmp_dir/members.cc"

# Now run the compiler to generate an assembler file.
${CXXCOMPILE} -x c++ -g0 -S - -o "$tmp_dir/offsets.s" < "$tmp_dir/members.cc"

# The assembler file consists of lines like these:
#
#   __CYGTLS__foo:
#       .long 42                (or .word on AArch64)
#       .globl __CYGTLS__foo
#       .align 4
#
# Use the generated declarations as an inventory: every member must have
# exactly one value in the assembly before any output can be published.
gawk '
  function fail (message) {
    print "Error: " message > "/dev/stderr";
    failed = 1;
    exit 1;
  }
  function uint32 (value,    number) {
    if (value !~ /^[0-9]+$/ && value !~ /^0[xX][0-9a-fA-F]+$/)
      fail("invalid offset for " varname ": " value);
    number = value ~ /^0[xX]/ ? strtonum (value) : value + 0;
    if (number > 4294967295)
      fail("offset out of uint32_t range for " varname);
    return number;
  }
  ARGIND == 1 {
    if ($1 == "extern") {
      name = $5;
      sub (/^__CYGTLS__/, "", name);
      if (name !~ /^[a-zA-Z_][a-zA-Z_0-9]*$/ || name in expected)
        fail("invalid or duplicate member declaration: " name);
      expected[name] = 1;
    }
    next;
  }
  {
    sub (/[[:space:]]*(#|\/\/).*$/, "");
  }
  match ($0, /^[[:space:]]*__CYGTLS__([a-zA-Z_0-9]+):[[:space:]]*$/, label) {
    if (length (varname) > 0 && !(varname in offsets))
      fail("missing offset for " varname);
    varname = label[1];
    if (!(varname in expected))
      fail("unexpected TLS member: " varname);
    if (varname in offsets)
      fail("duplicate offset for " varname);
    order[++count] = varname;
    next;
  }
  /^[[:space:]]*[^[:space:]:]+:/ {
    if (length (varname) > 0 && !(varname in offsets))
      fail("missing offset for " varname);
    varname = "";
    next;
  }
  length (varname) > 0 {
    if ($1 == ".long" || $1 == ".word") {
      if (varname in offsets)
        fail("multiple offset values for " varname);
      if (NF != 2)
        fail("expected one offset value for " varname);
      offsets[varname] = uint32($2);
    } else if ($1 == ".space" || $1 == ".zero") {
      if (varname in offsets)
        fail("multiple offset values for " varname);
      if ($0 !~ /^[[:space:]]*\.(space|zero)[[:space:]]+4([[:space:]]*,[[:space:]]*0)?[[:space:]]*$/)
        fail("expected four zero bytes for " varname);
      offsets[varname] = 0;
    } else if (!(varname in offsets) && NF > 0) {
      fail("unsupported offset directive for " varname ": " $1);
    }
  }
  END {
    if (failed)
      exit 1;
    for (name in expected)
      if (!(name in offsets))
        fail("missing offset for " name);
    if (!("start_offset" in offsets) || offsets["start_offset"] == 0)
      fail("missing or zero TLS start offset");
    if (!("context" in offsets))
      fail("missing context offset");
    if (offsets["context"] % 16 != 0)
      fail("_cygtls.context member is not 16 bytes aligned");

    start_offset = offsets["start_offset"];
    for (i = 1; i <= count; ++i) {
      name = order[i];
      if (name == "start_offset") {
        printf (".equ _cygtls.%s, -%u\n", name, start_offset);
      } else {
        printf (".equ _cygtls.%s, %d\n", name, offsets[name] - start_offset);
        printf (".equ _cygtls.%s_p, %d\n", name, offsets[name]);
      }
    }
  }
' "$tmp_dir/members.cc" "$tmp_dir/offsets.s" > "$tmp_dir/offsets"

# Keep the previous file intact on failure, including a failed compiler run.
mv -fT -- "$tmp_dir/offsets" "$output_file"
