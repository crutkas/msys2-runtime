#!/usr/bin/env bash
set -euo pipefail
if (( $# < 2 )); then
    echo "usage: $0 OUTPUT COMPILER [ARGUMENT ...]" >&2
    exit 2
fi
output=$1
shift
record=$(mktemp -d -- "${output}.link.XXXXXX")
{
    printf '#!/usr/bin/env bash\nset -euo pipefail\n'
    printf 'cd -- %q\n' "$PWD"
    for name in PATH SOURCE_DATE_EPOCH LC_ALL LIBRARY_PATH COMPILER_PATH GCC_EXEC_PREFIX; do
        if [[ -v $name ]]; then
            printf 'export %s=%q\n' "$name" "${!name}"
        else
            printf 'unset %s\n' "$name"
        fi
    done
    printf 'exec'
    printf ' %q' "$@"
    printf '\n'
} > "$record/command.sh"
printf '%s\0' "$@" > "$record/argv"
printf 'Link invocation: %s/command.sh\n' "$record"
status=0
"$@" > "$record/stdout" 2> "$record/stderr" || status=$?
printf '%d\n' "$status" > "$record/exit-status"
cat "$record/stdout"
cat "$record/stderr" >&2
if (( status == 0 )); then
    sha256sum -- "$output" > "$record/output.sha256"
fi
exit "$status"
