#!/bin/sh
# cygmagic - Generate "magic numbers" from a structure.
#
# This file is part of Cygwin.
#
# This software is a copyrighted work licensed under the terms of the
# Cygwin license.  Please consult the file "CYGWIN_LICENSE" for
# details.

set -e

file_magic=$1; shift
gcc=$1; shift
file=$1; shift

tmpfile=${TMPDIR:-/tmp}/$$.magic
trap 'rm -f "$tmpfile" "$tmpfile.pp" "$tmpfile.struct"' 0 1 2 15

cat <<EOF > "$tmpfile"
/* autogenerated - do not edit */
#include "$file"
EOF

sumit() {
    cksum "$@"
}

while [ -n "$1" ]; do
    define=$1; shift
    struct=$1; shift
    $gcc -D__CYGMAGIC__ -E -P "$file" > "$tmpfile.pp"
    sed -n "/^$struct/,/^};/p" "$tmpfile.pp" > "$tmpfile.struct"
    sed -e 's/[ 	]//g' -e '/^$/d' "$tmpfile.struct" > "$tmpfile.pp"
    checksum=`sumit "$tmpfile.pp" | awk '{print $1}'`
    sum=`printf '0x%xU' "$checksum"`
    echo "#define $define $sum"
    curr=`sed -n "s/^#[ 	]*define CURR_$define[ 	][ 	]*\([^ 	][^ 	]*\)/\1/p" "$file"`
    [ "$curr" != "$sum" ] && echo "*** WARNING WARNING WARNING WARNING WARNING ***
*** $file: magic number for $define changed old $curr != new $sum
*** WARNING WARNING WARNING WARNING WARNING ***" 1>&2
done >> "$tmpfile"

mv "$tmpfile" "$file_magic"

exit 0
