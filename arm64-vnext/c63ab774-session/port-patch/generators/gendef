	 *   mov xN, _cygtls.field     (load the .equ offset into a reg)
	 *   ldr/str wM, [xbase, xN]   (base + offset)
	 * because the offsets are large negatives (~-7000 to -12000) that
	 * exceed ARM64 immediate-offset ranges.
